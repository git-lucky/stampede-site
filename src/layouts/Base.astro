---
import '@/styles/site.css';
import '@/styles/pages.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import RecapScrollNote from '@/components/RecapScrollNote.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Which header link is the current page. */
  active?: 'cities' | 'plan';
}

const {
  title,
  description,
  ogImage = '/img/og-team-in-action.jpg',
  noIndex = false,
  structuredData,
  active,
} = Astro.props;

const siteName = 'Stampede';
const fullTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const home = Astro.url.pathname === '/';
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#174F6B" />
    {noIndex && <meta name="robots" content="noindex" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/urban-safari-logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <link rel="preload" href="/fonts/Overpass-Black.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {home && <RecapScrollNote />}
    <SiteHeader home={home} active={active} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter home={home} />
    <script>
      import '@/scripts/site.ts';
    </script>
  </body>
</html>
