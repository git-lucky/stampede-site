---
// "Meet your guide": a short moment on the homepage, just before the planner.
import { contact } from '@/content/contact';
---
<section class="guide-band" id="guide" aria-labelledby="guide-title">
  <div class="wrap guide-grid">
    <figure class="guide-photo"><img src="/img/guide/meet-your-guide.webp" width="800" height="600" alt="Mike, who guides Urban Safari hunts, with his camera under the pavilion during WooTown Scavengers." loading="lazy" /></figure>
    <div class="guide-copy">
      <h2 id="guide-title">Meet your guide</h2>
      <p class="guide-lede">Urban Safari is Mike’s passion. Every expedition. Every hunt.</p>
      <p class="guide-contact">Questions before you plan? Call <a href={contact.phoneHref}>{contact.phone}</a> or email <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
      <a class="btn btn-gold btn-lg" href="#plan">Plan an expedition</a>
    </div>
  </div>
</section>
