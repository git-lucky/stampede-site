---
// "How a hunt plays": the four steps, one practice phone in the Expedition Passport look (the only
// place you play), and one challenge detail card per kind that gets stamped when that kind is done.
import FaIcon from '@/components/home/FaIcon.astro';
import { practiceChallenges, detailCards, practiceRivals } from '@/content/practice';
import { faSvg } from '@/content/passportIcons';
import '@/styles/practice.css';
const MICRO = 'URBANSAFARIEXPEDITIONPASSPORT'.repeat(8);
---
<section class="how" id="how" aria-labelledby="how-title">
  <div class="wrap section-head how-intro">
    <h2>A little curiosity.<br />A lot of adventure.</h2>
    <p>We set the adventure in motion.<br />You bring the people who make it yours.</p>
  </div>

  <div class="wrap how-grid">
    <div class="how-copy">
      <div class="section-head">
        <h3 id="how-title" class="how-title">How a hunt plays</h3>
        <p>Each team plays from one phone. The rest is walking, talking and a fair amount of posing.</p>
      </div>
      <ol class="steps">
        <li><span class="step-n" aria-hidden="true">1</span><div><h4>Scan or tap to join</h4><p>Scan the QR code or open the link in your email. Then choose a team name and take a team photo.</p></div></li>
        <li><span class="step-n" aria-hidden="true">2</span><div><h4>Head out</h4><p>Challenges can be done in any order. Some send you to a place, others ask you to snap, film or answer something.</p></div></li>
        <li><span class="step-n" aria-hidden="true">3</span><div><h4>Score as you go</h4><p>Every finished challenge adds points and moves your team along the race track, so you always know where you stand.</p></div></li>
        <li><span class="step-n" aria-hidden="true">4</span><div><h4>Wrap up together</h4><p>At the end, everyone sees the final standings and the photos the teams took.</p></div></li>
      </ol>
    </div>

    <div class="practice">
      <button type="button" class="btn btn-line practice-toggle" id="practice-toggle" aria-expanded="false" aria-controls="practice-panel">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="3" /><path d="M10 5h4M11 19h2" /></svg>
        <span>Try a practice challenge</span>
        <svg class="practice-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>
      <div class="practice-panel" id="practice-panel" inert>
        <div class="practice-panel-inner">
          <figure class="practice-content" aria-labelledby="practice-cap">
      <div class="pp-device">
        <div class="pp-screen" id="pp">
          <span class="pp-notch" aria-hidden="true"></span>
          <div class="pp-band">
            <div class="pp-title-row">
              <p class="pp-title">Practice Safari</p>
              <span class="pp-progress" id="pp-progress">0 of {practiceChallenges.length}</span>
            </div>
            <div class="pp-strip">
              <div class="pp-track" id="pp-track" role="img" aria-label="Race track: your team is 3rd with 0 points">
                <span class="pp-line"></span>
                <FaIcon name="flag-checkered" class="pp-finish" />
                {practiceRivals.map((p) => <span class="pp-tile pp-rival" data-points={p} data-fa="user" set:html={faSvg('user')} />)}
                <span class="pp-you-ring" id="pp-you-ring"></span>
                <span class="pp-tile pp-you" id="pp-you"><img data-src="/img/practice/team-tile.webp" width="120" height="120" alt="" /></span>
              </div>
              <div class="pp-tag" id="pp-tag"><span class="pp-rank" id="pp-rank">3RD</span><span class="pp-pts"><b id="pp-score">0</b><small>PTS</small></span></div>
            </div>
            <p class="pp-micro" aria-hidden="true">{MICRO}</p>
          </div>

          <ul class="pp-list" id="pp-list" role="list">
            {practiceChallenges.map((c) => (
              <li>
                <button type="button" class="pp-row" data-kind={c.id} aria-haspopup="dialog">
                  <span class="pp-coin">
                    <span class="pp-pic"><img data-src={c.coin} width="240" height="240" alt="" /></span>
                    <svg class="pp-ring" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="34" fill="none" stroke="#fff" stroke-opacity=".75" stroke-width="1" stroke-dasharray="2.5 2.5" /></svg>
                    <span class="pp-coin-stamp"></span>
                  </span>
                  <span class="pp-text"><span class="pp-name">{c.title}</span><span class="pp-kind"><FaIcon name={c.fa} /><b>{c.points}</b></span></span>
                </button>
              </li>
            ))}
          </ul>

          <div class="pp-scrim" id="pp-scrim" hidden></div>
          <div class="pp-card" id="pp-card" hidden role="dialog" aria-modal="true" aria-labelledby="pp-card-title" tabindex="-1">
            <div class="pp-card-scroll">
              <div class="pp-card-pic" id="pp-card-pic">
                <img id="pp-card-img" alt="" />
                <span class="pp-card-grab" aria-hidden="true"></span>
                <button type="button" class="pp-card-close" id="pp-card-close" aria-label="Close challenge"><FaIcon name="xmark" /></button>
                <span class="pp-card-ring" aria-hidden="true"><svg viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="34" fill="none" stroke="#fff" stroke-opacity=".9" stroke-width="1.5" stroke-dasharray="3 3" /></svg><b id="pp-card-worth">100</b></span>
                <span class="pp-card-stamp" id="pp-card-stamp" aria-hidden="true"></span>
              </div>
              <div class="pp-card-body">
                <h4 class="pp-card-title" id="pp-card-title"></h4>
                <p class="pp-card-mission" id="pp-card-mission"></p>
                <form id="pp-form" novalidate>
                  <div id="pp-answer"></div>
                  <p class="pp-feedback" id="pp-feedback" role="status"></p>
                </form>
              </div>
            </div>
            <div class="pp-card-foot">
              <button type="submit" form="pp-form" class="pp-bar" id="pp-bar"><FaIcon name="camera" id="pp-bar-icon" /><span id="pp-bar-label">Snap it</span></button>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="practice-foot">
        <p id="practice-cap">A practice hunt in the app. Tap a challenge to play. Nothing is uploaded.</p>
        <button type="button" class="btn btn-quiet practice-reset" id="pp-reset" disabled><FaIcon name="rotate-left" />Start over</button>
      </figcaption>
      <input type="file" id="pp-file" accept="image/*" hidden />
          </figure>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap kinds-block">
    <h3 class="kinds-title">Four kinds of challenge, mixed into every hunt</h3>
    <p class="kinds-invite">A taste of each kind. Finish one on the phone and its card here gets a stamp.</p>
    <ul class="dcards" id="kinds" role="list">
      {detailCards.map((d) => (
        <li class="dcard" data-kind={d.kind}>
          <div class="dcard-pic">
            <img src={d.img} width="720" height="540" alt={d.alt} />
            <span class="dcard-grab" aria-hidden="true"></span>
            <span class="dcard-ring" aria-hidden="true"><svg viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="34" fill="none" stroke="#fff" stroke-opacity=".9" stroke-width="1.5" stroke-dasharray="3 3" /></svg><b>{d.points}</b></span>
            <span class="dcard-stamp" aria-hidden="true"></span>
          </div>
          <div class="dcard-body">
            <h4>{d.title}</h4>
            <p>{d.mission}</p>
            {d.answer === 'field' && <div class="dcard-answer" aria-hidden="true"><span class="d-label">Your answer</span><span class="d-field">Type your answer</span></div>}
            {d.answer === 'picks' && <div class="d-picks" aria-hidden="true">{d.picks?.map((p, i) => <span class="d-pick"><i>{'ABC'[i]}</i>{p}</span>)}</div>}
          </div>
          <div class="dcard-foot"><span class="d-bar"><FaIcon name={d.fa} />{d.verb}</span></div>
          <span class="vh dcard-status">Not stamped yet.</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import '@/scripts/practice-passport.ts';
</script>
