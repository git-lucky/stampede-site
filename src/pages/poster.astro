---
// Printable poster. On screen it sits inside the site header and footer; when printed,
// only the poster sheet prints. The QR code (public/img/qr-urbansafari-home.svg) was
// generated locally and encodes https://urbansafari.app/.
import Base from '@/layouts/Base.astro';
---
<Base title="Try Stampede Free — Demo" description="Scan to visit Stampede and try a practice hunt." noIndex>
  <section class="poster-stage paper" aria-labelledby="poster-title">
    <div class="wrap">
      <article class="poster-sheet">
        <div class="poster-top leather">
          <img src="/img/atlas-binoculars.webp" width="560" height="530" alt="" />
          <span class="foil-label">Demo Experience</span>
          <h1 id="poster-title">Try Stampede</h1>
          <p class="poster-sub">City-wide team building your crew will actually talk about.</p>
        </div>
        <div class="poster-bottom">
          <a class="poster-qr" href="https://urbansafari.app/"><img src="/img/qr-urbansafari-home.svg" width="200" height="200" alt="QR code: scan to visit urbansafari.app" /></a>
          <p class="poster-url"><a href="https://urbansafari.app/">urbansafari.app</a></p>
          <p class="poster-note">No app download required · Works on any device</p>
          <p class="poster-site">Plan your team's next adventure at <a href="https://urbansafari.app">urbansafari.app</a></p>
        </div>
      </article>
    </div>
  </section>
</Base>
