---
import Base from '@/layouts/Base.astro';
import Planner from '@/components/Planner.astro';
import { contact } from '@/content/contact';
---
<Base title="Plan your team’s Stampede" description="Tell Mike about your city, company and team. Start planning a custom corporate scavenger hunt." noIndex active="plan">
  <section class="plan-page paper" aria-labelledby="plan-page-title">
    <div class="wrap">
      <div class="plan-intro">
        <h1 class="page-title" id="plan-page-title">A good day starts here.</h1>
        <div class="plan-intro-copy">
          <p class="page-lede">Tell us a little about your team. We’ll help you build a Safari around your people, your schedule, and your city.</p>
          <div class="mike-note"><img class="mike-avatar" src="/img/guide/mike-note.webp" width="240" height="240" alt="Mike" /><p>Not sure about a date or headcount? A rough idea is plenty.<span>Mike, Stampede</span></p></div>
        </div>
      </div>
      <Planner open extended />
      <p class="plan-alt">Prefer to talk it through? Email <a href={`mailto:${contact.email}`}>{contact.email}</a> or call <a href={contact.phoneHref}>{contact.phone}</a>.</p>
    </div>
  </section>
</Base>
