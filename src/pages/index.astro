---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import HowItPlays from '@/components/home/HowItPlays.astro';
import ExpeditionOptions from '@/components/ExpeditionOptions.astro';
import Occasions from '@/components/home/Occasions.astro';
import GuideBand from '@/components/home/GuideBand.astro';
import Planner from '@/components/Planner.astro';
---

<Base
  title="Stampede · Nationwide team building scavenger hunts"
  description="Custom team building scavenger hunts in cities across the United States. From self-guided to fully hosted, built around your city for teams of 10 to 200+."
>
  <Hero />
  <HowItPlays />

  <section class="expeditions paper" id="expeditions" aria-labelledby="exp-title">
    <div class="wrap">
      <div class="section-head expedition-intro">
        <h2 id="exp-title">There’s more than<br />one way to Safari.</h2>
        <p>A little independence or a guide along for the ride.<br />Choose how you want to head out.</p>
      </div>
      <ExpeditionOptions />
    </div>
  </section>

  <Occasions />
  <GuideBand />

  <section class="plan paper" id="plan" aria-labelledby="plan-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="plan-title">Plan your expedition</h2>
        <p>Every great expedition starts with your people. Tell us a little about yours.</p>
      </div>
      <Planner />
    </div>
  </section>

</Base>
