---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { priorityCities } from '@/content/cities';
---

<Base
  title="Team building scavenger hunts by city"
  description="Explore team building scavenger hunts in featured cities, or plan a custom Stampede in your own city."
  active="cities"
>
  <section class="page-hero paper" aria-labelledby="cities-title">
    <div class="wrap page-hero-grid">
      <div>
        <h1 class="page-title" id="cities-title">Find your city. Plan your Safari.</h1>
        <p class="page-lede">Start with one of these featured cities, or tell us where your team is based. We can build a Safari in any city, with challenges tailored to your local area.</p>
        <div class="page-actions">
          <a class="btn btn-gold btn-lg" href="/plan/">Plan in another city</a>
          <a class="btn btn-quiet btn-lg" href="/#expeditions">Compare expeditions</a>
        </div>
      </div>
      <div class="page-art cities-art">
        <img src="/img/atlas-binoculars.webp" width="560" height="530" alt="Atlas the elephant scanning the horizon through binoculars." />
      </div>
    </div>
  </section>

  <section class="band band-start" aria-labelledby="directory-title">
    <div class="wrap">
      <div class="section-head"><h2 id="directory-title">Explore featured cities</h2></div>
      <ul class="city-grid" role="list">
        {priorityCities.map((city) => (
          <li>
            <a class="city-tile" href={`/cities/${city.slug}/`}>
              <Icon name="pin" class="city-pin" />
              <span><strong>{city.name}, {city.state}</strong><small>{city.region}</small></span>
              <svg class="city-go" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band-end" aria-labelledby="anywhere-title">
    <div class="wrap">
      <div class="leather leather-card leather-grid">
        <div>
          <span class="foil-label">Everywhere else</span>
          <h2 id="anywhere-title">Not listed? We can still build the game.</h2>
          <p>Tell us the city, team size, and timing. We scout the route, write the challenges, and recommend the right format for your group.</p>
        </div>
        <div class="leather-actions"><a class="btn btn-gold btn-lg" href="/plan/">Plan in another city</a></div>
      </div>
    </div>
  </section>
</Base>
