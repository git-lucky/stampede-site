---
import Base from '@/layouts/Base.astro';
import ExpeditionOptions from '@/components/ExpeditionOptions.astro';
import { priorityCities, type CityMarket } from '@/content/cities';
import { contact } from '@/content/contact';

export function getStaticPaths() {
  return priorityCities.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

interface Props {
  city: CityMarket;
}

const { city } = Astro.props;
const cityLabel = `${city.name}, ${city.state}`;
const title = `${cityLabel} team building scavenger hunts`;
const description = `${city.description} Plan a city-wide Stampede for teams of 10 to 200+ in ${cityLabel}.`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const planHref = `/plan/?${new URLSearchParams({ city: cityLabel })}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Stampede team building in ${cityLabel}`,
    serviceType: 'Corporate team building scavenger hunt',
    provider: {
      '@type': 'Organization',
      name: 'Stampede',
      url: Astro.site?.toString(),
      telephone: '+1-405-437-4597',
      email: contact.email,
    },
    areaServed: {
      '@type': 'City',
      name: city.name,
      address: {
        '@type': 'PostalAddress',
        addressRegion: city.state,
        addressCountry: 'US',
      },
    },
    url: canonicalUrl,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Cities', item: new URL('/cities/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: cityLabel, item: canonicalUrl },
    ],
  },
];
---

<Base title={title} description={description} structuredData={structuredData} active="cities">
  <section class="page-hero city-hero paper" aria-labelledby="city-title">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/cities/">Cities</a>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
        <span aria-current="page">{cityLabel}</span>
      </nav>
      <div class="page-hero-grid">
        <div>
          <h1 class="page-title" id="city-title">{city.headline}</h1>
          <p class="page-lede">{city.description}</p>
          <div class="page-actions">
            <a class="btn btn-gold btn-lg" href={planHref}>Plan {city.name}</a>
            <a class="btn btn-quiet btn-lg" href="#formats">Compare expeditions</a>
          </div>
        </div>
        <aside class="city-card" aria-labelledby="city-card-title">
          <img src="/img/atlas-binoculars.webp" width="560" height="530" alt="" />
          <div><h2 id="city-card-title">{cityLabel}</h2><p class="city-region">{city.region}</p></div>
          <ul class="city-facts" role="list">
            <li>10-200+ players</li>
            <li>Hosted or self-guided</li>
            <li>Custom route and challenges</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="route-title">
    <div class="wrap split">
      <div class="section-head">
        <h2 id="route-title">A local route, not a generic template.</h2>
        <p>We start with your meeting place, timing, team size, and finish line. Then we build a route that gives your group enough structure to stay together and enough surprise to make the day feel alive.</p>
      </div>
      <div class="route-card">
        <h3>Route ideas in {city.name}</h3>
        <ol class="mini-route">
          {city.routeIdeas.map((item, i) => (
            <li><span class="n" aria-hidden="true">{i + 1}</span><span>{item}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="band paper" aria-label="Planning notes and nearby teams">
    <div class="wrap open-cols notes-cols">
      <article>
        <h2>Built around your group.</h2>
        <ul class="sq-list" role="list">
          {city.planningNotes.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article>
        <h2>Serving the wider {city.region} area.</h2>
        <p>If your office, hotel, or venue is nearby, we can still use {city.name} as the anchor market and tailor the game to where your people are.</p>
        <ul class="chips" role="list">
          {city.nearby.map((nearby) => <li>{nearby}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="band" id="formats" aria-labelledby="formats-title">
    <div class="wrap">
      <div class="section-head"><h2 id="formats-title">Choose your {city.name} Safari.</h2></div>
      <ExpeditionOptions city={cityLabel} />
    </div>
  </section>

  <section class="band band-end" aria-labelledby="city-contact-title">
    <div class="wrap">
      <div class="leather leather-card leather-grid">
        <div>
          <span class="foil-label">Ready when you are</span>
          <h2 id="city-contact-title">Tell us about your {city.name} team.</h2>
          <p>Send your date, team size, and starting location. We will recommend the right tier and map out what the day could feel like.</p>
        </div>
        <div class="leather-actions">
          <a class="btn btn-gold btn-lg" href={planHref}>Plan {city.name}</a>
          <a class="btn btn-on-dark btn-lg" href={contact.phoneHref}>{contact.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
