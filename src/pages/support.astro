---
import Base from '@/layouts/Base.astro';
import { supportFaq, troubleshooting } from '@/content/faq';
import { contact } from '@/content/contact';

// Turn the support address inside a tip into a link.
const linkEmail = (text: string) =>
  text.replace(contact.email, `<a href="mailto:${contact.email}">${contact.email}</a>`);
---
<Base title="Support" description="Stuck during a Safari? Answers to the most common questions and a fast path to reach a human.">
  <section class="page-hero paper" aria-labelledby="help-title">
    <div class="wrap page-hero-grid">
      <div>
        <h1 class="page-title" id="help-title">How can we help?</h1>
        <p class="page-lede">Most in-game hiccups fix themselves in thirty seconds. When they don't, a real human is one email away.</p>
      </div>
      <div class="page-art help-art">
        <img src="/img/atlas-phone.webp" width="560" height="555" alt="Atlas the elephant chatting happily on an old-fashioned telephone." />
      </div>
    </div>
  </section>

  <section class="band-tight" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="help-card leather">
        <div class="help-who">
          <img class="help-photo" src="/img/guide/mike-support.webp" width="360" height="360" alt="Mike from Stampede" loading="lazy" />
          <div>
            <span class="foil-label">Talk to a person</span>
            <h2 id="contact-title">Email support</h2>
            <p>Questions, bug reports, anything tricky. Write to us.</p>
          </div>
        </div>
        <a class="btn btn-gold btn-lg" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
    </div>
  </section>

  <section class="band band-start" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="faq-grid">
        <div class="section-head"><h2 id="faq-title">While you're here…</h2></div>
        <div class="faq">
          {supportFaq.map((item, i) => (
            <details open={i === 0}>
              <summary><span>{item.q}</span><svg class="faq-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="band paper" aria-labelledby="tips-title">
    <div class="wrap">
      <div class="section-head"><h2 id="tips-title">Troubleshooting, minus the menu diving.</h2></div>
      <ul class="open-cols tips" role="list">
        {troubleshooting.map((t) => (
          <li><h3>{t.q}</h3><p set:html={linkEmail(t.a)} /></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
